#!/bin/sh
# Installed as /etc/initramfs-tools/hooks/gpu-rebar-layout
# Puts the gpu_rebar_layout module into the initramfs. See README.md
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
prereqs) prereqs; exit 0 ;;
esac
. /usr/share/initramfs-tools/hook-functions
manual_add_modules gpu_rebar_layout
